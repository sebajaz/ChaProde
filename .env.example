# ==========================================
# ChaProde - Configuración de Entorno (Docker / Producción)
# ==========================================

# Base de Datos PostgreSQL
POSTGRES_DB=chaprode_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=prodepw
DB_PORT=5432

# Servidor Backend (Ktor)
BACKEND_PORT=8080
DB_JDBC_URL=jdbc:postgresql://db:5432/chaprode_db

# Seguridad y Autenticación JWT
JWT_SECRET=chaprode_super_secret_jwt_key_2026_very_long_and_safe_token

# API de Deportes y Sincronizador Automático
FOOTBALL_API_TOKEN=
FOOTBALL_API_BASE_URL=https://api.football-data.org/v4
FOOTBALL_API_SYNC_INTERVAL=15
FOOTBALL_API_AUTO_SYNC=true

# Portal Web de Administración (React + Nginx)
WEB_PORT=80
DEV_WEB_PORT=3000
VITE_API_URL=
